# Bu dosya bir ORNEKTIR. Kopyalayip adini .env.local yapin ve degerleri doldurun.
# .env.local git'e gonderilmez; bu ornek dosya ise gonderilir, o yuzden buraya gercek deger yazmayin.

# Supabase paneli > Project Settings > API Keys
# Adres yalnizca https://xxxx.supabase.co olmali; sonuna /rest/v1/ EKLEMEYIN.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GIZLI anahtar: yalnizca sunucuda (dosya yukleme/silme ve test verisi betigi) kullanilir.
# Basina asla NEXT_PUBLIC_ eklemeyin; eklerseniz tarayiciya gider.
SUPABASE_SECRET_KEY=

# Sitenin adresi (e-posta dogrulama baglantilari icin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# KVKK metinleri ve tum yasal sayfalar (kullanim kosullari, gizlilik, cerez vb.) avukat tarafindan
# onaylaninca true yapin; o zamana kadar her birinde "Taslaktir" notu gorunur
KVKK_METINLERI_ONAYLI=false

# Olcek modulu: hazir olana kadar false kalsin
OLCEK_MODULU_AKTIF=false

# Ogrenci uzman bolumu: false iken listelenmez, kayit ve basvuru kapanir. Mevcut hesap ve sohbetler silinmez.
OGRENCI_MODULU_AKTIF=false

# Demo odeme modulu: true ise plan onayindan sonra demo odeme adimi gorunur. Gercek para hareketi YOKTUR.
# false iken plan ve onay calisir, odeme adimi ve komisyon gorunmez.
ODEME_MODULU_AKTIF=true

# Uydurma test hesaplarinin ortak sifresi (en az 8 karakter, kendiniz belirleyin)
SEED_TEST_SIFRESI=
